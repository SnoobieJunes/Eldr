<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Debug-only Info.plist additions, merged with the generated Info.plist
     (GENERATE_INFOPLIST_FILE stays YES). These exist solely for the S1
     MultipeerConnectivity local link (SPEC §10) and are NOT referenced by the
     Release configuration — TESTFLIGHT-GUIDE §A6: local-network permissions
     ship in no Release/TestFlight build until the stretch goal graduates. -->
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PQRC delivers end-to-end encrypted messages directly to nearby contacts when you are in the same room, with no server involved.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pqrc-local._tcp</string>
		<string>_pqrc-local._udp</string>
	</array>
</dict>
</plist>
