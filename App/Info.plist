<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chat.pqrc.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pqrc</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_pqrc-local._tcp</string>
		<string>_pqrc-local._udp</string>
		<string>_pqrc-relay._tcp</string>
		<string>_pqrc-relay._udp</string>
	</array>
	<!-- Allow plaintext HTTP ONLY to local/private network addresses (a
	     self-hosted LLM on your LAN, e.g. http://192.168.x.x:11434). The public
	     internet still requires HTTPS — every hosted AI/relay endpoint is https.
	     This is the scoped "http optional for self-hosted only" exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
