<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Eldr node ships UNSANDBOXED on purpose. Its whole job is to spawn arbitrary
	     developer harnesses (Claude Code, OpenClaw, Xcode/xcodebuild, /bin/zsh), write
	     launcher/config files under ~/.local/bin and ~/.config/eldr-acp, and make
	     outbound connections to a local LLM and a Nostr relay. App Sandbox is
	     fundamentally incompatible with that: a sandboxed app with no network-client
	     entitlement fails EVERY outbound connection with NSPOSIXErrorDomain 1
	     ("The operation couldn't be completed. Operation not permitted") — which is
	     exactly the LLM-connection error this reverts. Distribute via Developer ID +
	     notarization + Hardened Runtime (set in the project), NOT the App Sandbox / Mac
	     App Store. If you ever DO require the sandbox you must add at minimum
	     com.apple.security.network.client, com.apple.security.network.server, and a
	     user-selected/files exception for ~/.local/bin and ~/.config/eldr-acp — but
	     spawned harnesses inherit the sandbox and break, so unsandboxed is the
	     supported model. (Reverts the 2026-06-20 uncommitted "sandbox=true, no
	     exceptions" change — see statusreport.md §2.7 / DEVIATIONS AC36.) -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Routes the Configurator's long-term secrets into the DATA-PROTECTION keychain
	     (see KeychainBox.useDataProtection). A Developer ID app gets no
	     application-identifier from a provisioning profile, so without this entitlement
	     the data-protection keychain rejects access with errSecMissingEntitlement
	     (-34018). One team-scoped group is enough: items land in it by default (no
	     explicit kSecAttrAccessGroup), and because the group is keyed on the Team ID —
	     not the per-build code signature — every same-team rebuild reads silently,
	     ending the "Always Allow" prompt storm. $(AppIdentifierPrefix) expands to the
	     team id at signing time. eldr-node carries the same group (eldr-node.entitlements). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)chat.eldr.shared</string>
	</array>
</dict>
</plist>
