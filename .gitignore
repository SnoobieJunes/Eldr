.DS_Store
xcuserdata/
DerivedData/
.build/
*.xcresult

# Stray build output from command-line xcodebuild/swift build writing into the tree
build/
**/build/

# DMG / app build artifacts (signed/notarized builds aren't committed). Huginn is
# the renamed Eldr ACP Configurator; cover the current path, the old one, and any dist/.
Apps/Huginn/dist/
Apps/EldrACPConfigurator/dist/
**/dist/
# DMG build scratch + distribution/log output
**/.dmgbuild/
Logs/
logs/

# Merge/editor backup artifacts (e.g. *.swift~<branch> from a botched merge/checkout)
*.orig
*~
*.swift~*
